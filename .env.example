# Copy to .env.local for running `npm run send:reminders` locally.
# In production these are set as GitHub Actions repository secrets instead.
#
# Non-secret values (SUPABASE_URL, timezone, app url, VAPID public key) are read
# from public/config.js and do NOT need to be set here.

# Supabase service role key - SECRET. Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# VAPID keys - generate with `npm run gen:vapid` (writes SECRETS.local.txt).
VAPID_PRIVATE_KEY=
# Contact URI for push services. Use a mailto: with a real address.
VAPID_SUBJECT=mailto:you@example.com
